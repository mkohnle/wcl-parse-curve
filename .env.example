# Create a client at https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Optional: Upstash Redis, so the cache survives restarts (best left out for local development)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional
# PORT=3000
# Use https://classic.warcraftlogs.com for Classic (needs its own client)
# WCL_BASE_URL=https://www.warcraftlogs.com
